<?xml version="1.0"?>
<robot name="IRED">
    <link name="base_footprint"/>
    <link name="base_link">
        <!-- 3D model for display only (no collision). The STL is in mm with its
             floor at z=-30.6 mm and the base centre at (-94.0, 4.8) mm, so this
             origin puts that centre on base_link (0.11 m above the floor).
             The robot front (camera and arm) is -X in the STL, hence the 180 deg yaw. -->
        <visual>
            <origin xyz="-0.094 0.005 -0.0794" rpy="0.0 0.0 3.14159"/>
            <geometry>
                <mesh filename="package://ired_bringup/meshes/ired_body.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
    </link>
    <link name="wheel_front_left_link"/>
    <link name="wheel_front_right_link"/>
    <link name="wheel_rear_left_link"/>
    <link name="wheel_rear_right_link"/>
    <link name="base_scan"/>
    <link name="aruco_camera_link"/>
    <link name="base_cartesian_link"/>
    <link name="imu_link"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.11" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="scan_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_scan"/>
        <origin xyz="0.0 0.0 0.285" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- Camera lens is 0.23 m in front of the centre (from the 3D model) and 0.29 m above
         the floor (measured); base_link is 0.11 m above the floor.
         Keep colons out of comments here, bringup.launch.py parses this file as YAML. -->
    <joint name="aruco_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="aruco_camera_link"/>
        <origin xyz="0.23 0.0 0.18" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="base_cartesian_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_cartesian_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="wheel_front_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_front_right_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0.156 -0.156 -0.045" rpy="0.0 0.0 -0.785398"/>
    </joint>

    <joint name="wheel_front_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_front_left_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0.156 0.156 -0.045" rpy="0.0 0.0 0.785398"/>
    </joint>

    <joint name="wheel_rear_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_rear_right_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="-0.156 -0.156 -0.045" rpy="0.0 0.0 -2.35619"/>
    </joint>

    <joint name="wheel_rear_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_rear_left_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="-0.156 0.156 -0.045" rpy="0.0 0.0 2.35619"/>
    </joint>
</robot>
