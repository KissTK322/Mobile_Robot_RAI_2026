<?xml version="1.0"?>
<robot name="IRED">
    <link name="base_footprint"/>
    <link name="base_link">
        <!-- 3D model for display only (no collision), from Robocup_MobileRobot.stl of
             2026-10-22 (body 10 mm higher above the wheels than the 2026-10-19 one) reduced by
             vertex clustering. The STL is in mm with its floor at z=55.7 mm and the wheel centre
             at (-91.3, 1.9) mm as before,
             so this origin puts that centre on base_link (0.11 m above the floor). The robot
             front (camera) is -X in the STL, hence the 180 deg yaw. The SCARA arm is drawn
             unfolded, and the RPLidar is drawn turned 180 deg (CAD only, on the robot its
             motor side points forward). -->
        <visual>
            <origin xyz="-0.0913 0.0019 -0.1657" rpy="0.0 0.0 3.14159"/>
            <geometry>
                <mesh filename="package://ired_bringup/meshes/ired_body.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
    </link>
    <link name="wheel_front_left_link"/>
    <link name="wheel_front_right_link"/>
    <link name="wheel_rear_left_link"/>
    <link name="wheel_rear_right_link"/>
    <link name="base_scan"/>
    <link name="aruco_camera_link"/>
    <link name="base_cartesian_link"/>
    <link name="imu_link"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.11" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- RPLidar A1 head on the robot centre, laser plane about 0.305 m above the floor
         (2026-10-22 model, body 10 mm higher than the 2026-10-19 one), so 0.195 m above
         base_link. Measure the real plane on the robot. Yaw unchanged, the scan orientation
         was already checked against odometry and the motor side points forward. -->
    <joint name="scan_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_scan"/>
        <origin xyz="0.0 0.0 0.195" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- C270 camera, level, lens about 0.25 m in front of the centre (front face 0.26 m)
         and 0.13 m above the floor (camera block 0.111 to 0.148 m in the 2026-10-22 model),
         base_link is 0.11 m above the floor. Low enough to see the ArUco markers (centre about 0.10 m) straight on.
         Keep colons out of comments here, bringup.launch.py parses this file as YAML. -->
    <joint name="aruco_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="aruco_camera_link"/>
        <!-- robot test 2026-10-28 - lens 1.2 to 1.5 cm right of the centreline (y -0.013) and the
             marker height read 8.5 cm higher per metre of distance with a level camera, so the
             camera looks about 4.9 deg down (pitch +0.085 rad, positive pitch = looking down). -->
        <origin xyz="0.25 -0.013 0.020" rpy="0.0 0.085 0.0"/>
    </joint>

    <joint name="base_cartesian_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_cartesian_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="wheel_front_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_front_right_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0.156 -0.156 -0.045" rpy="0.0 0.0 -0.785398"/>
    </joint>

    <joint name="wheel_front_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_front_left_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0.156 0.156 -0.045" rpy="0.0 0.0 0.785398"/>
    </joint>

    <joint name="wheel_rear_right_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_rear_right_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="-0.156 -0.156 -0.045" rpy="0.0 0.0 -2.35619"/>
    </joint>

    <joint name="wheel_rear_left_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_rear_left_link"/>
        <axis xyz="0 1 0"/>
        <origin xyz="-0.156 0.156 -0.045" rpy="0.0 0.0 2.35619"/>
    </joint>
</robot>
