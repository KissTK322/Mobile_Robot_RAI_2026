scan_to_scan_filter_chain:
  ros__parameters:
    filter1:
      name: range
      type: laser_filters/LaserScanRangeFilter
      params:
        use_message_range_limits: false
        lower_threshold: 0.25
        upper_threshold: .inf
        lower_replacement_value: .nan
        upper_replacement_value: .inf
    filter2:
      name: angle_filter_1
      type: laser_filters/LaserScanAngularBoundsFilterInPlace
      params:
        lower_angle: -2.3847
        upper_angle: -2.2775
    filter3:
      name: angle_filter_2
      type: laser_filters/LaserScanAngularBoundsFilterInPlace
      params:
        lower_angle: -0.8248
        upper_angle: -0.7264
    filter4:
      name: angle_filter_3
      type: laser_filters/LaserScanAngularBoundsFilterInPlace
      params:
        lower_angle: 0.8222
        upper_angle: 0.8422
    filter5:
      name: angle_filter_4
      type: laser_filters/LaserScanAngularBoundsFilterInPlace
      params:
        lower_angle: 2.3124
        upper_angle: 2.3934
    filter6:
      name: angle_filter_5
      type: laser_filters/LaserScanAngularBoundsFilterInPlace
      params:
        lower_angle: 2.5041
        upper_angle: 2.5329
