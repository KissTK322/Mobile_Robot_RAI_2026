<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg name="use_sim_time" default="false"/>
  <arg name="cartographer_config_dir" default="$(find-pkg-share ired_navigation)/config"/>
  <arg name="configuration_basename" default="ired_rplidar_2d.lua"/>
  <arg name="resolution" default="0.05"/>
  <arg name="publish_period_sec" default="1.0"/>

  <!-- Cartographer Node -->
  <node pkg="cartographer_ros" exec="cartographer_node" name="cartographer_node" output="screen"
        args="-configuration_directory $(var cartographer_config_dir)
              -configuration_basename $(var configuration_basename)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/scan" to="/scan_filtered"/>
  </node>

  <!-- Occupancy Grid Node -->
  <node pkg="cartographer_ros" exec="cartographer_occupancy_grid_node" name="cartographer_occupancy_grid_node" output="screen"
        args="-resolution $(var resolution)
            -publish_period_sec $(var publish_period_sec)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>